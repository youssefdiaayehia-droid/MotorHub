@model MotorHub_Models.Brand

@{
    ViewData["Title"] = "Delete Brand";
}

<form method="post" asp-action="Delete">
    <input asp-for="Brandid" hidden />

    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Delete Brand</h2>
            <hr />
        </div>

        <div class="mb-3">
            <h4>Are you sure you want to delete this brand?</h4>
            <p><strong>Name:</strong> @Model.BrandName</p>
            <p><strong>Level:</strong> @Model.BrandLevel</p>
            <p><strong>Logo:</strong> @Model.BrandLogo</p>
        </div>

        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Brand" asp-action="Index" class="btn btn-secondary border form-control">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</form>