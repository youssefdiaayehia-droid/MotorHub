@model MotorHub_Models.Brand

@{
    var isEdit = Model.Brandid != 0;
    ViewData["Title"] = isEdit ? "Edit Brand" : "Create Brand";
}

<form method="post" asp-action="Upsert">
    <input asp-for="Brandid" hidden />

    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">@(isEdit ? "Edit Brand" : "Create Brand")</h2>
            <hr />
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="BrandName" class="p-0"></label>
            <input asp-for="BrandName" class="form-control" />
            <span asp-validation-for="BrandName" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="BrandLevel" class="p-0"></label>
            <input asp-for="BrandLevel" class="form-control" />
            <span asp-validation-for="BrandLevel" class="text-danger"></span>
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="BrandLogo" class="p-0"></label>
            <input asp-for="BrandLogo" class="form-control" />
            <span asp-validation-for="BrandLogo" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary form-control">
                    @(isEdit ? "Update" : "Create")
                </button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Brand" asp-action="Index" class="btn btn-secondary border form-control">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</form>