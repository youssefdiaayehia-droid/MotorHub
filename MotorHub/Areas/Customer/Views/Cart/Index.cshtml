@model MotorHub_Models.VM.ShoppingCartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container">
    <h2 class="text-primary">Shopping Cart</h2>
    <hr />

    @if (Model.ShoppingCartList != null && Model.ShoppingCartList.Any())
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Car</th>
                    <th>Price</th>
                    <th>Count</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ShoppingCartList)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Car.CarImage))
                            {
                                <img src="@item.Car.CarImage"
                                     style="width: 80px; height: 80px; object-fit: cover;"
                                     class="rounded" />
                            }
                        </td>
                        <td>@item.Car.CarName</td>
                        <td>$@item.Car.CarPrice.ToString("N0")</td>
                        <td>
                            <a asp-action="Minus" asp-route-cartId="@item.Id"
                               class="btn btn-sm btn-outline-secondary">-</a>
                            <span class="mx-2">@item.Count</span>
                            <a asp-action="Plus" asp-route-cartId="@item.Id"
                               class="btn btn-sm btn-outline-secondary">+</a>
                        </td>
                        <td>$@((item.Car.CarPrice * item.Count).ToString("N0"))</td>
                        <td>
                            <a asp-action="Remove" asp-route-cartId="@item.Id"
                               class="btn btn-danger btn-sm">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row pt-3">
            <div class="col-6"></div>
            <div class="col-6 text-end">
                <h4>Total: $@Model.OrderHeader.OrderTotal.ToString("N0")</h4>
                <a asp-action="Summary" class="btn btn-primary mt-2">Proceed to Checkout</a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Your cart is empty.
            <a asp-area="Customer" asp-controller="Home" asp-action="Index">
                Continue shopping
            </a>
        </div>
    }
</div>